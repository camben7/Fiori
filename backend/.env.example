PORT=4000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# Credenciales privadas solo para el servidor
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: cuando no se configura, el asistente usa respuestas de demostración
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Opcional: configurar SMTP si se desea enviar notificaciones por correo
CONTACT_NOTIFICATION_EMAIL=
